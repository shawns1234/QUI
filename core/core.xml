<Ui xmlns="http://www.blizzard.com/wow/ui/"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/..\FrameXML\UI.xsd">
    <!-- Core utilities (load first) -->
    <Script file="media.lua"/>
    <Script file="backwards.lua"/>
    
    <!-- Core main (must load before perfectpixel.lua) -->
    <Script file="quicore_main.lua"/>
    
    <!-- Core utilities (load after quicore_main) -->
    <Script file="perfectpixel.lua"/>
    
    <!-- Core systems -->
    <Script file="qui_module_registry.lua"/>
    <Script file="qui_options_page_registry.lua"/>
    <Script file="qui_anchoring_defaults.lua"/>
    <!-- Layout system modules (load before anchoring for backward compatibility) -->
    <Script file="qui_layout_state.lua"/>
    <Script file="qui_sizing.lua"/>
    <Script file="qui_positioning.lua"/>
    <Script file="qui_edit_mode.lua"/>
    <Script file="qui_layout_manager.lua"/>
    <Script file="qui_anchoring.lua"/>
    <Script file="qui_anchoring_options.lua"/>
    <Script file="qui_layout_control_options.lua"/>
    <!-- Layout system options (load after layout modules) -->
    <Script file="qui_positioning_options.lua"/>
    <Script file="qui_sizing_options.lua"/>
    <Script file="qui_layout_state_options.lua"/>
    <Script file="qui_layout_manager_options.lua"/>
    
    <!-- Core GUI -->
    <Script file="qui_gui.lua"/>
    <Script file="qui_options_shared.lua"/>
    <Script file="qui_options.lua"/>
    
    <!-- Core options -->
    <Script file="qui_general_options.lua"/>
    <Script file="qui_hudvisibility_options.lua"/>
    <Script file="qui_autohide_options.lua"/>
    <Script file="qui_blizzard_options.lua"/>
    <Script file="qui_importexport_options.lua"/>
    <Script file="qui_specprofiles_options.lua"/>
    <Script file="qui_strings_options.lua"/>
    <Script file="qui_search_options.lua"/>
