<Ui xmlns="http://www.blizzard.com/wow/ui/"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/..\FrameXML\UI.xsd">
    <!-- Load Libs First -->
    <Include file="libs\libs.xml" />

    <!-- AbstractFramework Core (BEFORE locales/init) -->
    <!-- Embedded libraries must load BEFORE Init.lua -->
    <Script file="AbstractFramework\Libs\utf8.lua" />
    <Script file="AbstractFramework\Libs\LibStub\LibStub.lua" />
    <Include file="AbstractFramework\Libs\CallbackHandler-1.0\CallbackHandler-1.0.xml" />
    <Script file="AbstractFramework\Libs\base64.lua" />
    <Script file="AbstractFramework\Libs\json.lua" />
    <Script file="AbstractFramework\Libs\md5.lua" />
    <Script file="AbstractFramework\Libs\sha256.lua" />
    <Script file="AbstractFramework\Libs\qrcode.lua" />
    <Script file="AbstractFramework\Libs\FAIAP.lua" />
    <Script file="AbstractFramework\Locales\enUS.lua" />
    <Script file="AbstractFramework\Utils\Math.lua" />
    <Script file="AbstractFramework\Utils\Table.lua" />
    <Script file="AbstractFramework\Init.lua" />
    <Script file="AbstractFramework\Utils\PixelUtil.lua" />

    <!-- Localalization Files -->
    <Include file="locales\locales.xml" />

    <!-- Addon Init -->
    <Script file="init.lua" />

    <!-- Util Files -->
    <Include file="utils\utils.xml" />

    <!-- Skinning Modules -->
    <Include file="skinning\skinning.xml" />

    <!-- Load Edit Mode Profiles -->
    <Include file="imports\imports.xml" />
</Ui>
